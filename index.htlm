];
let currentQuestionIndex = 0;
let score = 0;
let userAnswers = new Array(questionBank.length).fill(null);
function initQuiz() {
showQuestion(currentQuestionIndex);
}
function showQuestion(index) {
document.getElementById('progress-display').innerText = ${index + 1} / ${questionBank.length};
const q = questionBank[index];
document.getElementById('question-type-badge').innerText = q.type.toUpperCase();
document.getElementById('hint-box').style.display = "none";
document.getElementById('hint-box').innerText = q.hint || "Hãy đọc kỹ đề bài và lựa chọn đáp án phù hợp.";
let htmlContent = <div class="question-text">${q.text}</div>;
if(q.image) {
htmlContent += <img src="${q.image}" class="quiz-image" alt="Question Image">;
}
document.getElementById('question-content').innerHTML = htmlContent;
const optionsBox = document.getElementById('options-box');
optionsBox.innerHTML = '';
q.options.forEach((opt, oIdx) => {
const prefix = String.fromCharCode(65 + oIdx);
const card = document.createElement('div');
card.className = option-card ${userAnswers[index] === oIdx ? 'selected' : ''};
card.onclick = () => selectOption(oIdx);
card.innerHTML = <div class="option-prefix">${prefix}</div><div>${opt}</div>;
optionsBox.appendChild(card);
});
document.getElementById('btn-prev').disabled = index === 0;
if (index === questionBank.length - 1) {
document.getElementById('btn-next').innerText = "Hoàn thành";
} else {
document.getElementById('btn-next').innerText = "Sau →";
}
}
function selectOption(optionIndex) {
const currentQuestion = questionBank[currentQuestionIndex];
if(userAnswers[currentQuestionIndex] === currentQuestion.correct && optionIndex !== currentQuestion.correct) {
score -= 10;
} else if(userAnswers[currentQuestionIndex] !== currentQuestion.correct && optionIndex === currentQuestion.correct) {
score += 10;
}
userAnswers[currentQuestionIndex] = optionIndex;
document.getElementById('score-display').innerText = score;
const cards = document.querySelectorAll('.option-card');
cards.forEach((c, idx) => {
if(idx === optionIndex) c.classList.add('selected');
else c.classList.remove('selected');
});
}
function navigateQuestion(step) {
currentQuestionIndex += step;
if(currentQuestionIndex >= questionBank.length) {
finishQuiz();
} else {
showQuestion(currentQuestionIndex);
}
}
function skipQuestion() {
navigateQuestion(1);
}
function toggleHint() {
const hintBox = document.getElementById('hint-box');
hintBox.style.display = hintBox.style.display === "none" ? "block" : "none";
}
function finishQuiz() {
document.getElementById('quiz-box').innerHTML = <div id="summary-screen"> <h2 style="color: #2e7d32;">🎉 Chúc mừng em đã hoàn thành bài thi! 🎉</h2> <p style="font-size: 18px; margin-top: 10px;">Kết quả tổng kết của hệ thống IOE MAI NGOC:</p> <div class="score-highlight">${score} Điểm</div> <p style="color: #666;">Số câu làm đúng: ${score / 10} / ${questionBank.length} câu hỏi.</p> <button class="btn btn-primary" style="margin-top: 25px; border-radius: 4px;" onclick="window.location.reload()">Làm lại bài thi</button> </div>;
document.getElementById('controls').style.display = "none";
}
window.onload = initQuiz;
